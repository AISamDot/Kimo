# Optional. Leave unset to store everything in ./data (local files).
# Set to a Postgres connection string for hosted deployments (e.g. Vercel),
# where local files don't persist. Tables are created automatically.
# Supabase: use the "Transaction pooler" connection string (port 6543).
DATABASE_URL=

# Optional: where local data lives when DATABASE_URL is not set (default ./data)
BUDDY_DATA_DIR=
